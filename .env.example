# Copy this file to .env and fill in real values:   cp .env.example .env
# .env is git-ignored. Never put real keys in this file or in code.

# Which hosted model the *target agent* uses.
#   LLM_PROVIDER: openai | anthropic
#   LLM_MODEL:    any chat model name that provider's API accepts, e.g.
#                 openai    -> gpt-4o-mini-2024-07-18
#                 anthropic -> a current Claude model ID from Anthropic's docs
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini-2024-07-18

# Only the key for the provider you use is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
